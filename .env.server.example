# 服务器部署时复制为 .env；不要提交真实密码。
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8088
SERVER_LAN_ADDRESS=192.168.0.253

BUSINESS_DATA_ROOT=D:/BusinessManagementApp/data
BUSINESS_BACKUP_ROOT=D:/BusinessManagementApp/backups

POSTGRES_DB=business_management
POSTGRES_USER=business_app
POSTGRES_PASSWORD=请替换为至少24位随机密码

MINIO_ROOT_USER=business_storage
MINIO_ROOT_PASSWORD=请替换为至少24位随机密码
MINIO_BUCKET=business-attachments

JWT_SECRET=请替换为至少48位随机密钥
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=请替换为至少16位初始密码
SEED_INITIAL_DATA=true
SELF_REGISTRATION_ENABLED=true
REGISTRATION_DEPARTMENT_CODE=BUSINESS

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
