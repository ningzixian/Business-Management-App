{
  "name": "department-steward",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "商务活动管理 Web 与部门小管家移动端 v0.2.0 双库协作基础版",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "dev:api": "npm run dev --prefix server",
    "build": "tsc -b && vite build",
    "build:api": "npm run build --prefix server",
    "build:mobile": "tsc -b && vite build --mode mobile",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:api": "npm test --prefix server",
    "verify": "npm run typecheck && npm run build && npm run build:api && npm run test:api",
    "mobile:sync": "npm run build:mobile && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "lucide-react": "^1.40.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
